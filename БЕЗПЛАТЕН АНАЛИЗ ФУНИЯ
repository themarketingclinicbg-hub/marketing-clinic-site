<div class="page" id="page">

<!-- ===== HEADER ===== -->
<header>
  <div class="container header-inner">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="38" cy="38" r="28" fill="none" stroke="#F5F1E8" stroke-width="8"/>
        <line x1="58" y1="58" x2="88" y2="88" stroke="#F5F1E8" stroke-width="10" stroke-linecap="round"/>
