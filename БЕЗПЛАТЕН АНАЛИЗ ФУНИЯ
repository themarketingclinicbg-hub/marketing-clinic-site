<style>
  :root {
    color-scheme: light;
    --green:    #1E3A2E;
    --green-dk: #13241C;
    --green-soft:#2C5141;
    --cream:    #F5F1E8;
    --cream-2:  #FBF9F3;
    --cream-3:  #EFE8D9;
    --ink:      #1C1C1A;
    --muted:    #6F6B62;
    --line:     #E4DECF;
    --gold:     #B08D57;
    --white:    #FFFFFF;
    --red:      #A8534F;
    --logo-bg:  #F5F1E8;
    --serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --sans:  'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  body {
    font-family: var(--sans);
    color: var(--ink);
    line-height: 1.6;
    background: var(--cream-2);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  /* заключваме скрола докато интрото свири (иначе на телефон подскача) */
  body.anim.lock { overflow: hidden; height: 100vh; }
  img { max-width: 100%; display: block; }

  .container { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
  .narrow { max-width: 720px; margin-left: auto; margin-right: auto; }
  .centered { text-align: center; }

  .eyebrow {
    display: inline-block;
    font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
    font-weight: 600; color: var(--gold); margin-bottom: 20px;
  }

  h1, h2, h3 { font-family: var(--serif); font-weight: 700; color: var(--green); }
  h1 { font-size: clamp(33px, 4.8vw, 52px); line-height: 1.12; letter-spacing: -0.5px; }
  h2 { font-size: clamp(28px, 3.6vw, 40px); line-height: 1.16; letter-spacing: -0.3px; }
  .lead { font-size: 18px; color: var(--muted); line-height: 1.65; }

  /* ===== BUTTONS ===== */
  .btn {
    display: inline-block; font-family: var(--sans);
    font-weight: 700; font-size: 14px; letter-spacing: 1.2px;
    text-transform: uppercase; text-decoration: none; cursor: pointer;
    padding: 17px 34px; border-radius: 6px; border: none; min-height: 44px;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
  }
  .btn-light { background: var(--cream); color: var(--green); box-shadow: 0 10px 24px rgba(0,0,0,.18); }
  .btn-light:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(0,0,0,.24); background: var(--white); }

  /* ===== HEADER ===== */
  header { background: var(--green); color: var(--cream); padding: 20px 0; border-bottom: 1px solid rgba(245,241,232,.10); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .brand { display: flex; align-items: center; gap: 14px; }
  .brand-mark { width: 40px; height: 40px; flex-shrink: 0; }
  .brand-text { line-height: 1.1; }
  .brand-name { font-family: var(--serif); font-weight: 700; font-size: 18px; color: var(--cream); letter-spacing: .3px; }
  .brand-tag { font-size: 10.5px; letter-spacing: .6px; opacity: .65; margin-top: 3px; }
  .header-cta {
    background: transparent; color: var(--cream); border: 1px solid rgba(245,241,232,.4);
    padding: 12px 22px; border-radius: 6px; text-decoration: none;
    font-weight: 600; font-size: 13px; letter-spacing: .6px;
    transition: background .18s ease, border-color .18s ease;
  }
  .header-cta:hover { background: rgba(245,241,232,.10); border-color: var(--cream); }

  /* ===== SECTIONS ===== */
  section { padding: 104px 0; }
  .sec-cream { background: var(--cream); }
  .sec-white { background: var(--white); }
  .sec-mission { padding: 72px 0; }
  .mission-quote { font-family: var(--serif); font-size: clamp(22px, 3vw, 30px); color: var(--green); line-height: 1.35; max-width: 800px; margin: 0 auto; }
  .mission-quote .gold { color: var(--gold); font-style: italic; }

  /* ===== TOP: FORM ===== */
  .top { background: var(--green); color: var(--cream); padding: 64px 0 96px; }
  .top .eyebrow { color: var(--gold); }
  .top h1 { color: var(--white); }
  .top h1 em { color: var(--cream); font-style: italic; }
  .top .lead { color: var(--cream); opacity: .9; margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.6; }
  .top .lead .hl { color: var(--gold); font-weight: 700; letter-spacing: .3px; }

  .scarcity {
    display: inline-flex; flex-direction: column; align-items: center; gap: 2px;
    margin: 26px auto 0; padding: 14px 30px;
    background: rgba(245,241,232,.06); border: 1px solid rgba(245,241,232,.18); border-radius: 999px;
    color: var(--cream); font-size: 14.5px; line-height: 1.4;
  }
  .scarcity .s1 { font-weight: 600; }
  .scarcity .s2 { opacity: .82; font-size: 13.5px; }
  .scarcity .num { color: var(--gold); font-weight: 800; }

  .form-card {
    max-width: 600px; margin: 30px auto 0;
    background: var(--white); color: var(--ink); padding: 40px; border-radius: 16px;
    border: 1px solid var(--line); box-shadow: 0 30px 70px rgba(15,30,22,.22);
  }
  .form-row { margin-bottom: 18px; text-align: left; }
  .form-row label {
    display: block; font-size: 11.5px; font-weight: 700; letter-spacing: .8px;
    text-transform: uppercase; color: var(--green); margin-bottom: 8px;
  }
  .form-row label .opt { color: var(--muted); font-weight: 500; text-transform: none; letter-spacing: 0; }
  .form-row input {
    width: 100%; padding: 14px 16px; font-size: 16px; font-family: inherit;
    color: var(--ink); background: var(--cream-2);
    border: 1px solid var(--line); border-radius: 8px;
    transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .form-row input::placeholder { color: #ABA79D; }
  .form-row input:focus { outline: none; border-color: var(--green); background: var(--white); box-shadow: 0 0 0 3px rgba(30,58,46,.10); }
  .btn-submit {
    width: 100%; margin-top: 6px; background: var(--green); color: var(--cream);
    border: none; border-radius: 8px; padding: 17px; min-height: 48px;
    font-family: var(--sans); font-size: 14px; font-weight: 700;
    letter-spacing: 1.2px; text-transform: uppercase; cursor: pointer;
    transition: background .18s ease, transform .18s ease;
  }
  .btn-submit:hover { background: var(--green-dk); transform: translateY(-1px); }
  .form-note { font-size: 12px; color: var(--muted); text-align: center; margin-top: 16px; line-height: 1.55; }

  /* ===== PRESENTATION PREVIEW (карусел) ===== */
  .pv-wrap { margin-top: 48px; position: relative; }
  .pv-track {
    display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 8px 4px 22px; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .pv-track::-webkit-scrollbar { display: none; }
  .pv-slide {
    flex: 0 0 min(560px, 86%); scroll-snap-align: center;
    background: var(--green); color: var(--cream); border-radius: 14px;
    padding: 34px 32px; text-align: left; min-height: 320px;
    display: flex; flex-direction: column; gap: 14px;
    box-shadow: 0 18px 44px rgba(15,30,22,.16);
  }
  .pv-slide .pv-kicker { font-size: 11px; letter-spacing: 2.4px; text-transform: uppercase; color: var(--gold); font-weight: 700; }
  .pv-slide h3 { color: var(--white); font-size: 22px; line-height: 1.25; }
  .pv-slide p { font-size: 14.5px; line-height: 1.6; opacity: .88; }
  .pv-box { background: rgba(245,241,232,.07); border: 1px solid rgba(245,241,232,.16); border-radius: 10px; padding: 14px 16px; font-size: 14px; line-height: 1.55; }
  .pv-box strong { color: var(--gold); }
  .pv-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .pv-chip {
    background: rgba(245,241,232,.09); border: 1px solid rgba(245,241,232,.2);
    border-radius: 999px; padding: 7px 14px; font-size: 12.5px; font-weight: 600;
  }
  .pv-chip.gold { color: var(--gold); border-color: rgba(176,141,87,.55); }
  .pv-stat { display: flex; align-items: baseline; gap: 8px; }
  .pv-stat .n { font-family: var(--serif); font-size: 30px; color: var(--gold); font-weight: 700; }
  .pv-stat .l { font-size: 12.5px; opacity: .8; }
  .pv-foot { margin-top: auto; font-size: 11px; letter-spacing: .5px; opacity: .55; }
  .pv-dots { display: flex; justify-content: center; gap: 8px; margin-top: 4px; }
  .pv-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line); border: none; padding: 0; cursor: pointer; transition: background .2s, transform .2s; }
  .pv-dot.on { background: var(--gold); transform: scale(1.25); }
  .pv-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--white); color: var(--green); font-size: 20px; cursor: pointer;
    box-shadow: 0 8px 20px rgba(15,30,22,.12); z-index: 2;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .pv-nav:hover { transform: translateY(-50%) scale(1.06); }
  .pv-prev { left: -12px; }
  .pv-next { right: -12px; }
  .pv-hint { font-size: 12.5px; color: var(--muted); margin-top: 10px; }

  /* ===== SPLIT ===== */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px; }
  .split-col { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 36px; text-align: left; box-shadow: 0 14px 40px rgba(15,30,22,.05); }
  .split-col h3 { font-size: 19px; margin-bottom: 20px; }
  .split-col.no h3 { color: var(--red); }
  .split-col ul { list-style: none; }
  .split-col li { position: relative; padding: 9px 0 9px 32px; font-size: 15.5px; color: var(--ink); line-height: 1.55; }
  .split-col.yes li::before { content: ''; position: absolute; left: 4px; top: 12px; width: 6px; height: 11px; border: solid var(--green); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .split-col.no li::before { content: ''; position: absolute; left: 3px; top: 17px; width: 13px; height: 1.5px; background: var(--red); }

  /* ===== CARDS ===== */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
  .card { background: var(--cream-2); border: 1px solid var(--line); border-radius: 14px; padding: 34px; transition: transform .2s ease, box-shadow .2s ease; text-align: left; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 20px 44px rgba(15,30,22,.10); }
  .card-num { font-family: var(--serif); font-size: 30px; color: var(--gold); margin-bottom: 14px; line-height: 1; }
  .card h3 { font-size: 19px; margin-bottom: 12px; line-height: 1.3; }
  .card p { font-size: 15px; color: var(--muted); line-height: 1.65; }
  .card p strong { color: var(--green); font-weight: 600; }

  /* ===== FAQ ===== */
  .faq { max-width: 760px; margin: 44px auto 0; text-align: left; }
  .faq-item { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 14px; background: var(--white); overflow: hidden; transition: box-shadow .2s ease; }
  .faq-item[open] { box-shadow: 0 14px 36px rgba(15,30,22,.07); }
  .faq-item summary {
    cursor: pointer; padding: 22px 26px; list-style: none;
    font-family: var(--serif); font-weight: 600; font-size: 18px; color: var(--green);
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-family: var(--sans); font-size: 26px; font-weight: 300; color: var(--gold); line-height: 1; flex-shrink: 0; transition: transform .2s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item .faq-a { padding: 0 26px 24px; color: var(--muted); font-size: 15.5px; line-height: 1.7; }

  /* ===== BOTTOM CTA ===== */
  .cta-bottom { background: var(--green); color: var(--cream); text-align: center; padding: 96px 0; }
  .cta-bottom .eyebrow { color: var(--gold); }
  .cta-bottom h2 { color: var(--white); }
  .cta-bottom .lead { color: var(--cream); opacity: .9; margin: 16px auto 32px; max-width: 540px; }

  /* ===== STICKY MOBILE CTA ===== */
  .sticky-cta {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 900;
    display: none; padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgba(19,36,28,.97); backdrop-filter: blur(6px);
    border-top: 1px solid rgba(245,241,232,.14);
    transform: translateY(110%); transition: transform .25s ease;
  }
  .sticky-cta.show { transform: translateY(0); }
  .sticky-cta a {
    display: block; text-align: center; background: var(--gold); color: var(--green-dk);
    font-weight: 700; font-size: 14px; letter-spacing: 1px; text-transform: uppercase;
    text-decoration: none; border-radius: 8px; padding: 15px; min-height: 48px;
  }

  /* ===== FOOTER ===== */
  footer { background: var(--green-dk); color: var(--cream); padding: 40px 0; font-size: 14px; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 22px; flex-wrap: wrap; }
  .footer-brand { font-family: var(--serif); font-weight: 700; font-size: 17px; }
  .footer-tag { opacity: .7; margin-top: 3px; font-size: 12.5px; }
  .footer-links a { color: var(--cream); text-decoration: none; margin-left: 24px; opacity: .8; transition: opacity .15s ease; }
  .footer-links a:hover { opacity: 1; }

  /* ===== INTRO LOGO-ZOOM ANIMATION (DO NOT CHANGE) ===== */
  .page { position: relative; z-index: 1; }
  .intro { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; pointer-events: none; overflow: hidden; }
  .intro__bg { position: absolute; inset: 0; background: var(--logo-bg); }
  .intro__logo { position: relative; width: min(360px, 82vw); text-align: center; transform-origin: 50% 46%; will-change: transform, opacity, filter; }
  .intro__mark { width: 82px; height: 82px; margin: 0 auto 16px; display: block; }
  .intro__name { font-family: var(--serif); font-weight: 700; font-size: clamp(24px, 6.5vw, 32px); color: var(--green); letter-spacing: .3px; line-height: 1.1; }
  .intro__tag { font-size: 11.5px; letter-spacing: 1.8px; text-transform: uppercase; color: var(--gold); margin-top: 10px; }
  .done .intro { display: none; }
  .anim .intro__logo { animation: logoFocus 0.6s cubic-bezier(.2,.7,.3,1) both, logoDive 1.05s cubic-bezier(.62,.03,.8,.15) 0.95s forwards; }
  .anim .intro__bg { animation: bgOut 0.5s ease 1.6s forwards; }
  .anim .page      { animation: pageReveal 0.95s cubic-bezier(.16,.84,.3,1) 1.05s both; }
  @keyframes logoFocus {
    0%   { opacity: 0; transform: scale(.86); filter: blur(10px); }
    55%  { opacity: 1; filter: blur(0); }
    100% { opacity: 1; transform: scale(1);  filter: blur(0); }
  }
  @keyframes logoDive {
    0%   { opacity: 1; transform: scale(1); }
    45%  { opacity: 1; }
    100% { opacity: 0; transform: scale(6); }
  }
  @keyframes bgOut { to { opacity: 0; } }
  @keyframes pageReveal {
    0%   { opacity: 0; transform: translateY(-38px); -webkit-clip-path: circle(0% at 50% 47%); clip-path: circle(0% at 50% 47%); }
    55%  { opacity: 1; }
    100% { opacity: 1; transform: translateY(0); -webkit-clip-path: circle(150% at 50% 47%); clip-path: circle(150% at 50% 47%); }
  }
  /* по-лека интро анимация за телефон: без тежкия zoom-dive и clip-path */
  @keyframes logoFadeOut { 0% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.12); } }
  @keyframes pageFade { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 700px) {
    .intro__logo { width: 260px; }
    .anim .intro__logo { animation: logoFocus 0.5s cubic-bezier(.2,.7,.3,1) both, logoFadeOut 0.45s ease 0.95s forwards; }
    .anim .intro__bg  { animation: bgOut 0.45s ease 1.05s forwards; }
    .anim .page       { animation: pageFade 0.55s ease 1.0s both; }
  }
  @media (prefers-reduced-motion: reduce) { .intro { display: none !important; } .anim .page { animation: none; } }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 820px) {
    section { padding: 72px 0; }
    .top { padding: 44px 0 72px; }
    .cards { grid-template-columns: 1fr; }
    .split { grid-template-columns: 1fr; }
    .form-card { padding: 28px 22px; }
    .header-cta { display: none; }
    .footer-inner { flex-direction: column; text-align: center; }
    .footer-links a { margin: 0 12px; }
    .pv-nav { display: none; }
    .sticky-cta { display: block; }
    .page { padding-bottom: 76px; } /* място за sticky CTA бара */
  }

  /* ===== ТЕЛЕФОН ===== */
  @media (max-width: 520px) {
    section { padding: 60px 0; }
    .container { padding: 0 20px; }
    .top { padding: 34px 0 60px; }
    h1 { font-size: clamp(26px, 8vw, 34px); }
    h2 { font-size: clamp(24px, 7vw, 30px); }
    .eyebrow { margin-bottom: 14px; }
    .form-card { padding: 22px 18px; margin-top: 24px; }
    .scarcity { width: 100%; padding: 12px 18px; }
    .pv-slide { flex-basis: 90%; padding: 26px 22px; min-height: 300px; }
    .pv-slide h3 { font-size: 20px; }
    .card { padding: 26px 24px; }
    .split-col { padding: 28px 24px; }
    .faq-item summary { font-size: 16.5px; padding: 20px 20px; }
    .mission-quote { font-size: 21px; }
  }
</style>
</head>
<body class="anim">

<!-- ===== INTRO OVERLAY ===== -->
<div class="intro" id="intro" aria-hidden="true">
  <div class="intro__bg"></div>
  <div class="intro__logo" id="introLogo">
    <svg class="intro__mark" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
