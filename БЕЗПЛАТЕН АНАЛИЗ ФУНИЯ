<!-- ===== PREVIEW CAROUSEL ===== -->
<script>
  (function () {
    var track = document.getElementById('pvTrack');
    var dotsWrap = document.getElementById('pvDots');
    var slides = track.querySelectorAll('.pv-slide');
    var i;
    for (i = 0; i < slides.length; i++) {
      var d = document.createElement('button');
      d.className = 'pv-dot' + (i === 0 ? ' on' : '');
      d.type = 'button';
      d.setAttribute('aria-label', 'Слайд ' + (i + 1));
      d.dataset.i = i;
      dotsWrap.appendChild(d);
    }
    var dots = dotsWrap.querySelectorAll('.pv-dot');
    function goTo(n) {
      var s = slides[Math.max(0, Math.min(slides.length - 1, n))];
      track.scrollTo({ left: s.offsetLeft - (track.clientWidth - s.clientWidth) / 2, behavior: 'smooth' });
    }
    function current() {
      var c = track.scrollLeft + track.clientWidth / 2, best = 0, bd = 1e9, j;
      for (j = 0; j < slides.length; j++) {
        var mid = slides[j].offsetLeft + slides[j].clientWidth / 2;
        if (Math.abs(mid - c) < bd) { bd = Math.abs(mid - c); best = j; }
      }
      return best;
    }
    var t;
    track.addEventListener('scroll', function () {
      clearTimeout(t);
      t = setTimeout(function () {
        var cur = current(), k;
        for (k = 0; k < dots.length; k++) dots[k].classList.toggle('on', k === cur);
      }, 80);
    });
    dotsWrap.addEventListener('click', function (e) {
      if (e.target.dataset && e.target.dataset.i) goTo(+e.target.dataset.i);
      else if (e.target.classList.contains('pv-dot')) goTo(+e.target.dataset.i);
    });
    document.getElementById('pvPrev').addEventListener('click', function () { goTo(current() - 1); });
    document.getElementById('pvNext').addEventListener('click', function () { goTo(current() + 1); });
  })();
</script>

