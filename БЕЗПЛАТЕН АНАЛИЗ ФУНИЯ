<meta name="description" content="Губиш клиенти онлайн, а не знаеш къде е проблемът? Получи безплатен анализ от The Marketing Clinic: персонализирана презентация до 24 часа, която показва къде течат парите и как да ги спреш.">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light only">
<meta name="theme-color" content="#1E3A2E">

<!-- ===== FONTS (non-blocking) ===== -->
